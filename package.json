{
  "name": "mcp-chilegob-dataset",
  "version": "0.3.0",
  "description": "MCP server exposing Chile's open government dataset portal (datos.gob.cl / CKAN API v3)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gerardbourguett/mcp-chilegob-dataset.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chile",
    "open-data",
    "datos-gob-cl",
    "ckan",
    "hono"
  ],
  "bin": {
    "mcp-chilegob-dataset": "./dist/stdio.js"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
"@hono/node-server": "^2.0.10",
    "@modelcontextprotocol/hono": "^2.0.0-alpha.2",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "hono": "^4.12.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
